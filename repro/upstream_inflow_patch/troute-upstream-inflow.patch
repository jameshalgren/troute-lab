+def read_upstream_inflow_file(path):
+    """
+    Read upstream inflow boundary series: the outflow (m3/s) of each boundary
+    segment over time.
+
+    CSV: one row per segment. First column: segment ID (any header, e.g.
+         feature_id). Remaining column headers: timestamps (UTC, any format
+         pandas parses, e.g. 2021-08-23 13:00:00).
+    NetCDF: a variable named flow, streamflow, q or inflow on dimensions
+         (time, feature_id) in either order, with coordinate variables time
+         (CF-decodable) and feature_id.
+
+    Returns a DataFrame indexed by int64 segment ID, with a sorted
+    DatetimeIndex as columns.
+    """
+    path = pathlib.Path(path)
+    if path.suffix.lower() in (".nc", ".nc4", ".cdf", ".netcdf"):
+        with xr.open_dataset(path) as ds:
+            names = [v for v in ("flow", "streamflow", "q", "inflow") if v in ds.data_vars]
+            if not names:
+                raise ValueError(
+                    f"{path}: no flow variable (expected one of flow, streamflow, q, inflow)"
+                )
+            da = ds[names[0]].transpose("feature_id", "time")
+            df = pd.DataFrame(
+                np.asarray(da.values, dtype="float64"),
+                index=pd.Index(ds["feature_id"].values.astype("int64")),
+                columns=pd.DatetimeIndex(ds["time"].values),
+            )
+    else:
+        df = pd.read_csv(path, index_col=0)
+        df.index = df.index.astype("int64")
+        df.columns = pd.to_datetime(df.columns)
+        df = df.astype("float64")
+    df = df.sort_index(axis=1)
+    if df.index.has_duplicates:
+        raise ValueError(f"{path}: duplicate segment IDs")
+    if df.columns.has_duplicates:
+        raise ValueError(f"{path}: duplicate timestamps")
+    if df.isna().to_numpy().any():
+        raise ValueError(f"{path}: missing values")
+    return df
+
+
+def _interp_boundary(df, times):
+    """Linear interpolation of each row of df (DatetimeIndex columns) at times."""
+    ref = df.columns.values[0].astype("datetime64[ns]")
+    x = (df.columns.values.astype("datetime64[ns]") - ref) / np.timedelta64(1, "s")
+    xt = (np.asarray(times, dtype="datetime64[ns]") - ref) / np.timedelta64(1, "s")
+    v = df.to_numpy(dtype="float64")
+    return np.vstack([np.interp(xt, x, row) for row in v])
+
+
 def get_timesteps_from_nex(nexus_files):
