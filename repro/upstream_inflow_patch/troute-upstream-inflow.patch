+    # ------------------------------------------------------------------
+    # Upstream inflow boundaries
+    # ------------------------------------------------------------------
+    def apply_upstream_boundaries(self):
+        """
+        Clip the routed network at upstream inflow boundary segments.
+
+        forcing_parameters:
+          upstream_inflow_file     -- CSV or NetCDF file with the outflow time
+                                      series (m3/s) of each boundary segment
+                                      (see read_upstream_inflow_file)
+          upstream_inflow_segments -- optional list of boundary segment IDs;
+                                      default: every segment in the file
+
+        Each boundary segment B and everything upstream of it is removed from
+        the routed network. B is kept as an off-network upstream of the segment
+        it drains to: that segment receives B's prescribed outflow as upstream
+        inflow, exactly as it would receive B's routed outflow in a run of the
+        full network. B's lateral inflow is not added again (it is part of the
+        prescribed outflow). The rows of the removed segments stay in the
+        parameter dataframe but are not routed or written.
+
+        Muskingum-Cunge only ("serial" and "by-network" compute methods).
+        """
+        fp = self.forcing_parameters or {}
+        inflow_file = fp.get("upstream_inflow_file", None)
+        if not inflow_file:
+            return
+        df = read_upstream_inflow_file(inflow_file)
+        segments = fp.get("upstream_inflow_segments", None)
+        if segments:
+            segments = [int(s) for s in segments]
+            missing = sorted(set(segments) - set(df.index))
+            if missing:
+                raise ValueError(
+                    f"upstream_inflow_segments not found in {inflow_file}: {missing[:10]}"
+                )
+            df = df.loc[segments]
+
+        conn = self.connections
+        unknown = [s for s in df.index if s not in conn]
+        if unknown:
+            raise ValueError(
+                f"upstream inflow boundary segments not in the routing network: {unknown[:10]}"
+            )
+        outlets = [s for s in df.index if not conn[s]]
+        if outlets:
+            raise ValueError(
+                f"upstream inflow boundary segments are outlets (nothing downstream to route): {outlets[:10]}"
+            )
+
+        # everything upstream of the boundaries
+        rconn = self.reverse_network
+        upstream = set()
+        stack = [u for b in df.index for u in rconn.get(b, ())]
+        while stack:
+            s = stack.pop()
+            if s not in upstream:
+                upstream.add(s)
+                stack.extend(rconn.get(s, ()))
+        nested = sorted(upstream.intersection(df.index))
+        if nested:
+            LOG.warning(
+                "%d upstream inflow boundaries lie upstream of another boundary and are ignored: %s",
+                len(nested), nested[:10],
+            )
+            df = df.drop(nested)
+        removed = upstream | set(df.index)
+
+        # Clip the topology. The segment below each boundary keeps the boundary
+        # in its list of upstreams (reverse connections), which is how the
+        # compute kernel finds the prescribed inflow.
+        for s in removed:
+            conn.pop(s, None)
+            rconn.pop(s, None)
+        for net in self.independent_networks.values():
+            for s in removed:
+                net.pop(s, None)
+        for tw, reaches in self.reaches_by_tailwater.items():
+            clipped = ([s for s in r if s not in removed] for r in reaches)
+            self._reaches_by_tw[tw] = [r for r in clipped if r]
+
+        self._upstream_boundary_df = df
+
+        # Initial state of the boundaries: the prescribed flow at t0 if the
+        # series covers t0, else the restart value.
+        t0 = np.datetime64(self.t0, "ns")
+        covered = df.columns[0] <= t0
+        q_t0 = _interp_boundary(df, np.array([t0]))[:, 0]
+        q0 = self.q0
+        rows = pd.DataFrame(index=df.index, columns=["qu0", "qd0", "h0"], dtype="float32")
+        rows.loc[:, :] = 0.0
+        known = df.index.intersection(q0.index)
+        rows.loc[known] = q0.loc[known, ["qu0", "qd0", "h0"]].to_numpy()
+        if covered:
+            rows["qu0"] = q_t0
+            rows["qd0"] = q_t0
+        else:
+            unknown_q0 = df.index.difference(q0.index)
+            if len(unknown_q0):
+                LOG.warning(
+                    "upstream inflow series start after t0 and %d boundaries have no "
+                    "restart value; using the first value of their series", len(unknown_q0),
+                )
+                rows.loc[unknown_q0, "qu0"] = df.loc[unknown_q0].iloc[:, 0].to_numpy()
+                rows.loc[unknown_q0, "qd0"] = df.loc[unknown_q0].iloc[:, 0].to_numpy()
+        self._q0 = pd.concat([q0.drop(df.index, errors="ignore"), rows.astype("float32")])
+
+        LOG.info(
+            "upstream inflow boundaries: %d segments from %s; %d upstream segments removed from routing",
+            len(df), inflow_file, len(upstream - set(df.index)),
+        )
+
+    @property
+    def upstream_boundary_segments(self):
+        """IDs of the upstream inflow boundary segments (empty if none)."""
+        if getattr(self, "_upstream_boundary_df", None) is None:
+            return pd.Index([])
+        return self._upstream_boundary_df.index
+
+    def upstream_boundary_flows(self, t0, dt, nts):
+        """
+        Prescribed boundary outflows for one routing window, in the form of
+        compute_nhd_routing_v02's ``flowveldepth_interorder`` argument:
+        {segment: {"results": float32 array [q1, 0, 0, q2, 0, 0, ...]}} for the
+        routing timesteps t0 + k*dt, k = 1..nts. The series is linearly
+        interpolated in time; outside its range the end values are held (with
+        a warning). Also stores the end-of-window flows that new_q0 carries
+        forward as the boundaries' initial state for the next window.
+        """
+        df = self._upstream_boundary_df
+        if df is None or df.empty:
+            return {}
+        t = np.datetime64(t0, "ns") + np.arange(1, nts + 1) * np.timedelta64(int(dt * 1e9), "ns")
+        if t[-1] > df.columns[-1] or t[0] - np.timedelta64(int(dt * 1e9), "ns") < df.columns[0]:
+            LOG.warning(
+                "upstream inflow series (%s to %s) do not cover the routing window "
+                "%s to %s; end values are held",
+                df.columns[0], df.columns[-1], t0, t[-1],
+            )
+        q = _interp_boundary(df, t)
+        out = {}
+        for i, seg in enumerate(df.index):
+            fvd = np.zeros((nts, 3), dtype="float32")
+            fvd[:, 0] = q[i]
+            out[seg] = {"results": fvd.ravel()}
+        last = q[:, -1].astype("float32")
+        self._upstream_boundary_q0 = pd.DataFrame(
+            {"qu0": last, "qd0": last, "h0": np.zeros_like(last)}, index=df.index
+        )
+        return out
+
