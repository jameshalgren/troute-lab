+def _boundary_upstreams(flowveldepth_interorder, upstream_connections, segs):
+    """
+    Upstream inflow boundaries feeding one independent network.
+
+    A boundary is an off-network segment that is not routed: its outflow is
+    prescribed as a time series (AbstractNetwork.apply_upstream_boundaries). It
+    still appears as an upstream in the network's reverse connections, so the
+    segment it drains to picks up the prescribed flow as upstream inflow.
+    """
+    if not flowveldepth_interorder:
+        return set()
+    ups = set(chain.from_iterable(upstream_connections.get(s, ()) for s in segs))
+    return ups.intersection(flowveldepth_interorder)
+
+
+def _boundary_upstream_results(flowveldepth_interorder, offnetwork_upstreams, data_idx):
+    """
+    The ``upstream_results`` argument of compute_network_structured for the
+    boundaries of one network: {segment: {"results": [q, v, d, q, v, d, ...],
+    "position_index": row of the segment in data_idx}}.
+    """
+    return {
+        us: {
+            "results": flowveldepth_interorder[us]["results"],
+            "position_index": data_idx.get_loc(us),
+        }
+        for us in offnetwork_upstreams
+    }
+
